# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://aisha:aisha@localhost:5432/aisha?schema=public"
PORT=4000
# The site allowed to call the API (CORS).
FRONTEND_ORIGIN="http://localhost:3000"
NODE_ENV=development
# Proxies in front of the API in production (usually 1), so rate limits see real IPs.
TRUST_PROXY=0
